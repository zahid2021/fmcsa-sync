# Copy to .env on the VPS and fill in values. Do not commit .env.

FMCSA_WEBKEY=your_fmcsa_webkey_here

# MySQL (on VPS usually localhost)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fmcsaaa
MYSQL_TABLE=carrierinformation_csv

# Optional: if direct FMCSA returns 403 from this machine, set Zyte key
# Leave empty to call FMCSA directly (preferred on US VPS).
ZYTE_API_KEY=
